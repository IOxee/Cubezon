# Copy this file to .env (repo root) and web/.env.local and fill in the values. Never commit the real ones.

# Supabase (web)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: never expose it to the client
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Optional: original item icons ({id} = material). Defaults to mc.nerothe.com 1.21.11
NEXT_PUBLIC_ITEM_ICON_URL=https://mc.nerothe.com/img/1.21.11/minecraft_{id}.png
# Optional: face of each player's skin ({uuid} without hyphens, {size} in px). Defaults to mc-heads.net
NEXT_PUBLIC_PLAYER_HEAD_URL=https://mc-heads.net/avatar/{uuid}/{size}
# Development only (ignored in a production build): 1 = allows buying from your own shops
CUBEZON_DEV_ALLOW_SELF_PURCHASE=

# Postgres (plugin): direct connection or session pooler (port 5432), not the transaction pooler (6543)
CUBEZON_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
CUBEZON_DB_USER=postgres.<project-ref>
CUBEZON_DB_PASSWORD=
